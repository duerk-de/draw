lum  : 0.015
sat  : 3
hue  : 230
datay : 5.60833-8.40572*sin[[[col1-yearstart]+5915769.94103]/[daysperyear*days/360]]
plot

out   : test_draw.bmp

EOF

}

args | xargs -d \\n /usr/bin/time -f "%E" "./draw-arm"
dbd

